<?php
declare(strict_types=1);

const SESSION_DEVICE_SMARTPHONE = 'SMARTPHONE';
const SESSION_DEVICE_C_BUERO = 'C_BUERO';
const SESSION_C_BUERO_TIMEOUT_SECONDS = 86400;

function session_start_if_needed(): void
{
    if (session_status() === PHP_SESSION_ACTIVE) {
        return;
    }
    if (headers_sent($file, $line)) {
        throw new RuntimeException("Session kann nicht gestartet werden; Ausgabe in {$file}:{$line}.");
    }

    $secure = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off');
    session_set_cookie_params([
        'lifetime' => 0,
        'path' => '/',
        'domain' => '',
        'secure' => $secure,
        'httponly' => true,
        'samesite' => 'Lax',
    ]);
    session_start();
}

function session_normalize_device_type(string $deviceType): string
{
    $deviceType = strtoupper(trim($deviceType));
    if (!in_array($deviceType, [SESSION_DEVICE_SMARTPHONE, SESSION_DEVICE_C_BUERO], true)) {
        throw new InvalidArgumentException('Unbekannter Gerätetyp.');
    }
    return $deviceType;
}

function session_auth_is_valid(): bool
{
    session_start_if_needed();
    $auth = $_SESSION['auth'] ?? null;
    if (!is_array($auth) || empty($auth['user_id']) || empty($auth['device_type'])) {
        return false;
    }

    $deviceType = session_normalize_device_type((string)$auth['device_type']);
    if ($deviceType === SESSION_DEVICE_C_BUERO) {
        $lastActivity = (int)($auth['last_activity'] ?? 0);
        if ($lastActivity <= 0 || (time() - $lastActivity) > SESSION_C_BUERO_TIMEOUT_SECONDS) {
            session_destroy_current();
            return false;
        }
        $_SESSION['auth']['last_activity'] = time();
    }
    return true;
}

function session_destroy_current(): void
{
    session_start_if_needed();
    $_SESSION = [];
    if (ini_get('session.use_cookies')) {
        $params = session_get_cookie_params();
        setcookie(session_name(), '', [
            'expires' => time() - 42000,
            'path' => $params['path'],
            'domain' => $params['domain'],
            'secure' => (bool)$params['secure'],
            'httponly' => (bool)$params['httponly'],
            'samesite' => $params['samesite'] ?? 'Lax',
        ]);
    }
    session_destroy();
}

function csrf_token(): string
{
    session_start_if_needed();
    if (empty($_SESSION['csrf_token'])) {
        $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
    }
    return (string)$_SESSION['csrf_token'];
}

function csrf_validate(?string $token): bool
{
    session_start_if_needed();
    return is_string($token)
        && isset($_SESSION['csrf_token'])
        && hash_equals((string)$_SESSION['csrf_token'], $token);
}

function csrf_require_valid(?string $token): void
{
    if (!csrf_validate($token)) {
        http_response_code(419);
        exit('Ungültige oder abgelaufene Anfrage.');
    }
}
