<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Flug manuell erfassen</title>

<link rel="stylesheet" href="app.css">
</head><body>
<h1>Flug manuell erfassen</h1><div class="nav"><a href="#" onclick="nav('dashboard.php');return false;">Dashboard</a><a href="#" onclick="nav('flight_approvals.php');return false;">Flugfreigaben</a><a href="#" onclick="nav('manual_flight.php');return false;">+ Flug manuell erfassen</a></div>
<div class="card"><div class="row"><label>Datum <input id="date" type="date"></label><label>Status <select id="status"><option value="pending">pending</option><option value="all">all</option></select></label><label>Benutzer <input id="user" value="demo"></label></div></div>
<div class="tabs"><button id="b_glider" onclick="showMode('glider')">Segelflug</button><button id="b_tow" onclick="showMode('tow')">Motorflug</button><button id="b_pair" onclick="showMode('pair')">Segelflug + Motorflug</button><button id="b_attachTow" onclick="showMode('attachTow')">Schlepp zu Segelflug</button><button id="b_attachGlider" onclick="showMode('attachGlider')">Segelflug zu Schlepp</button></div><div id="content"></div>
<script>
function qs(id){return document.getElementById(id)}function today(){return new Date().toISOString().slice(0,10)}function getParam(n,f){const p=new URLSearchParams(location.search);return p.get(n)||f}function filterQuery(){return 'date='+encodeURIComponent(qs('date').value)+'&status='+encodeURIComponent(qs('status').value)+'&user='+encodeURIComponent(qs('user').value)}function nav(page){location.href=page+'?'+filterQuery()}function esc(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}function fmt(v){if(!v)return '';let s=String(v).replace('T',' ');let d=s.slice(0,10).split('-');return d.length===3?`${d[2]}.${d[1]}.${d[0]} ${s.slice(11,16)}`:s}function timeOnly(v){if(!v)return '';return String(v).replace('T',' ').slice(11,16)}function goList(op){location.href='flight_approvals.php?'+filterQuery()+(op?'#op-'+op:'')}function minBetween(a,b){if(!a||!b)return '';let [ah,am]=a.split(':').map(Number),[bh,bm]=b.split(':').map(Number);let m=(bh*60+bm)-(ah*60+am);return m>=0?m:''}function mark(id,on){const el=qs(id);if(el)el.classList.toggle('req',!!on)}
async function postJson(url,data){const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const j=await r.json();if(j.warning){const msg=(j.warnings||[]).join('\n');if(confirm('Warnung:\n'+msg+'\n\nTrotzdem speichern?')){data.force=1;return postJson(url,data)}return j}if(!j.ok){alert(j.error||'Fehler')}else{goList(j.operation_id)}return j}
qs('date').value=getParam('date',getParam('from',today()));qs('status').value=getParam('status','pending');qs('user').value=getParam('user','demo');let flightTypes=[],towTypes=[],chargeModes=[],candidates=null;
async function loadLists(){if(!flightTypes.length){let r=await fetch('../src/api_flight_types.php?category=glider');flightTypes=(await r.json()).flight_types||[]}if(!towTypes.length){let r=await fetch('../src/api_flight_types.php?category=tow');towTypes=(await r.json()).flight_types||[]}if(!chargeModes.length){let r=await fetch('../src/api_charge_modes.php?context=glider');chargeModes=(await r.json()).charge_modes||[]}let r=await fetch('../src/api_manual_candidates.php?date='+encodeURIComponent(qs('date').value)+'&_='+Date.now());candidates=await r.json()}
function ftOptions(list){let h='<option value="">Bitte wählen</option>';list.forEach(x=>h+=`<option value="${esc(x.id)}">${esc(x.code)} - ${esc(x.name)}</option>`);return h}function chargeOptions(){let h='';chargeModes.forEach(x=>h+=`<option value="${esc(x.id)}" ${String(x.id)==='2'?'selected':''}>${esc(x.display_name||x.name)}</option>`);return h}function candidateOptions(list,label){let h='<option value="">Bitte wählen</option>';(list||[]).forEach(x=>{const sel=String(x.operation_id)===String(getParam('operation_id',''))?' selected':'';h+=`<option value="${esc(x.operation_id)}"${sel}>${esc(label(x))}</option>`});return h}function commonFields(){return `<div class="row"><label>Startzeit<input id="takeoff" type="time" oninput="calcAll()"></label><label>Landezeit<input id="landing" type="time" oninput="calcAll()"></label><label>Startort<input id="dep" value="LSZJ"></label><label>Landeort<input id="arr" value="LSZJ"></label></div><div class="calc" id="calcMain"></div>`}function findCandidate(list,opId){return(list||[]).find(x=>String(x.operation_id)===String(opId))}function setInput(id,val){const el=qs(id);if(el&&val!==undefined&&val!==null)el.value=val}function calcAll(){if(qs('takeoff')&&qs('landing'))qs('calcMain').innerHTML='Resultierende Flugzeit: '+(minBetween(qs('takeoff').value,qs('landing').value)||'')+' min';if(qs('takeoff')&&qs('towlanding')&&qs('calcTow'))qs('calcTow').innerHTML='Resultierende Motorflugzeit: '+(minBetween(qs('takeoff').value,qs('towlanding').value)||'')+' min';if(qs('takeoff')&&qs('gliderlanding')&&qs('calcGlider'))qs('calcGlider').innerHTML='Resultierende Segelflugzeit: '+(minBetween(qs('takeoff').value,qs('gliderlanding').value)||'')+' min'}
function validateFields(rules){let errors=[];rules.forEach(x=>{let el=qs(x.id);let missing=!el||!el.value;mark(x.id,missing);if(missing)errors.push(x.label)});let t=qs('takeoff')?.value;if(qs('landing')&&t&&qs('landing').value<t){mark('landing',true);errors.push('Landezeit darf nicht vor der Startzeit liegen')}if(qs('towlanding')&&t&&qs('towlanding').value<t){mark('towlanding',true);errors.push('Landung Motorflugzeug darf nicht vor der Startzeit liegen')}if(qs('gliderlanding')&&t&&qs('gliderlanding').value<t){mark('gliderlanding',true);errors.push('Landung Segelflugzeug darf nicht vor der Startzeit liegen')}if(errors.length){alert('Speichern nicht möglich.\n\nBitte ausfüllen/korrigieren:\n- '+errors.join('\n- '));return false}return true}
function attachTowChanged(){const x=findCandidate(candidates.glider_entries,qs('opid').value);if(!x){qs('knownInfo').innerHTML='';return}qs('knownInfo').innerHTML=`<b>Bekannter Segelflug:</b> ${esc(x.callsign)}<br>Start: ${fmt(x.departure_time)}<br>Landung: ${fmt(x.arrival_time)}<br>Flugminuten: ${esc(x.flight_minutes||'')}`;setInput('takeoff',timeOnly(x.departure_time));calcAll()}function attachGliderChanged(){const x=findCandidate(candidates.towplane_entries,qs('opid').value);if(!x){qs('knownInfo').innerHTML='';return}qs('knownInfo').innerHTML=`<b>Bekannter Motorflug:</b> ${esc(x.callsign)}<br>Start: ${fmt(x.departure_time)}<br>Landung: ${fmt(x.arrival_time)}<br>Flugminuten: ${esc(x.flight_minutes||'')}`;setInput('takeoff',timeOnly(x.departure_time));setInput('towlanding',timeOnly(x.arrival_time));calcAll()}
async function showMode(m){await loadLists();document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('active'));qs('b_'+m).classList.add('active');let c=qs('content');if(m==='glider'){c.innerHTML=`<div class="card"><h2>Segelflug ohne FLARM</h2><div class="row"><label>Segelflugzeug<input id="glider"></label><label>Pilot<input id="pilot"></label><label>Begleiter / FI<input id="att"></label></div>${commonFields()}<div class="row"><label>Flugart<select id="ft">${ftOptions(flightTypes)}</select></label><label>Abrechnungsart<select id="charge">${chargeOptions()}</select></label></div><label>Kommentar<textarea id="comment"></textarea></label><button class="ok" onclick="submitGlider()">Manuellen Segelflug speichern</button></div>`}if(m==='tow'){c.innerHTML=`<div class="card"><h2>Motorflug ohne Segelflug</h2><div class="row"><label>Flugzeug<input id="plane"></label><label>Motorpilot<input id="towpilot"></label></div>${commonFields()}<div class="row"><label>Flugart<select id="ft">${ftOptions(towTypes)}</select></label><label>Abrechnungsart<select id="charge">${chargeOptions()}</select></label></div><label>Kommentar<textarea id="comment"></textarea></label><button class="ok" onclick="submitTow()">Motorflug speichern</button></div>`}if(m==='pair'){c.innerHTML=`<div class="card"><h2>Segelflug + Motorflug</h2><div class="row"><label>Segelflugzeug<input id="glider"></label><label>Segelflugpilot<input id="pilot"></label><label>Begleiter / FI<input id="att"></label></div><div class="row"><label>Motor-/Schleppflugzeug<input id="plane"></label><label>Motor-/Schlepppilot<input id="towpilot"></label></div><div class="row"><label>Startzeit<input id="takeoff" type="time" oninput="calcAll()"></label><label>Landung Motorflugzeug<input id="towlanding" type="time" oninput="calcAll()"></label><label>Landung Segler<input id="gliderlanding" type="time" oninput="calcAll()"></label></div><div id="calcTow" class="calc"></div><div id="calcGlider" class="calc"></div><div class="row"><label>Flugart Segler<select id="ft">${ftOptions(flightTypes)}</select></label><label>Abrechnungsart<select id="charge">${chargeOptions()}</select></label></div><button class="ok" onclick="submitPair()">Kompletten Flug speichern</button></div>`}if(m==='attachTow'){c.innerHTML=`<div class="card"><h2>Schlepp zu bestehendem Segelflug erfassen</h2><div class="row"><label>Bestehender Segelflug<select id="opid" onchange="attachTowChanged()">${candidateOptions(candidates.glider_entries,x=>`${x.callsign} ${fmt(x.departure_time)} ${x.pilot_name||''}`)}</select></label><label>Motor-/Schleppflugzeug<input id="plane"></label><label>Motor-/Schlepppilot<input id="towpilot"></label></div><div id="knownInfo" class="info"></div><div class="row"><label>Startzeit<input id="takeoff" type="time" oninput="calcAll()"></label><label>Landung Motorflugzeug<input id="towlanding" type="time" oninput="calcAll()"></label></div><div id="calcTow" class="calc"></div><button class="ok" onclick="submitAttachTow()">Schlepp zuordnen</button></div>`;attachTowChanged()}if(m==='attachGlider'){c.innerHTML=`<div class="card"><h2>Segelflug zu bestehendem Motorflug erfassen</h2><div class="row"><label>Bestehender Motorflug<select id="opid" onchange="attachGliderChanged()">${candidateOptions(candidates.towplane_entries,x=>`${x.callsign} ${fmt(x.departure_time)} ${x.tow_pilot_name||''}`)}</select></label><label>Segelflugzeug<input id="glider"></label><label>Segelflugpilot<input id="pilot"></label><label>Begleiter / FI<input id="att"></label></div><div id="knownInfo" class="info"></div><div class="row"><label>Startzeit<input id="takeoff" type="time" oninput="calcAll()"></label><label>Landung Motorflugzeug<input id="towlanding" type="time" oninput="calcAll()"></label><label>Landung Segler<input id="gliderlanding" type="time" oninput="calcAll()"></label></div><div id="calcTow" class="calc"></div><div id="calcGlider" class="calc"></div><div class="row"><label>Flugart Segler<select id="ft">${ftOptions(flightTypes)}</select></label><label>Abrechnungsart<select id="charge">${chargeOptions()}</select></label></div><button class="ok" onclick="submitAttachGlider()">Segelflug zuordnen</button></div>`;attachGliderChanged()}}
function base(){return{user:qs('user').value,date:qs('date').value,departure_location:qs('dep')?.value||'LSZJ',arrival_location:qs('arr')?.value||'LSZJ'}}function submitGlider(){if(!validateFields([{id:'glider',label:'Segelflugzeug fehlt'},{id:'takeoff',label:'Startzeit fehlt'},{id:'landing',label:'Landezeit fehlt'},{id:'ft',label:'Flugart fehlt'},{id:'charge',label:'Abrechnungsart fehlt'}]))return;return postJson('../src/api_create_manual_flight.php',{...base(),mode:'glider_only',glider_callsign:qs('glider').value,pilot_name:qs('pilot').value,attendant_name:qs('att').value,takeoff_time:qs('takeoff').value,landing_time:qs('landing').value,vf_flight_type_id:qs('ft').value,charge_mode:qs('charge').value,comment:qs('comment').value})}function submitTow(){if(!validateFields([{id:'plane',label:'Motorflugzeug fehlt'},{id:'takeoff',label:'Startzeit fehlt'},{id:'landing',label:'Landezeit fehlt'},{id:'ft',label:'Flugart fehlt'},{id:'charge',label:'Abrechnungsart fehlt'}]))return;return postJson('../src/api_create_manual_flight.php',{...base(),mode:'towplane_only',tow_callsign:qs('plane').value,tow_pilot_name:qs('towpilot').value,takeoff_time:qs('takeoff').value,landing_time:qs('landing').value,vf_flight_type_id:qs('ft').value,charge_mode:qs('charge').value,comment:qs('comment').value})}function submitPair(){if(!validateFields([{id:'glider',label:'Segelflugzeug fehlt'},{id:'plane',label:'Motorflugzeug fehlt'},{id:'takeoff',label:'Startzeit fehlt'},{id:'towlanding',label:'Landung Motorflugzeug fehlt'},{id:'gliderlanding',label:'Landung Segelflugzeug fehlt'},{id:'ft',label:'Flugart Segelflug fehlt'},{id:'charge',label:'Abrechnungsart Segelflug fehlt'}]))return;return postJson('../src/api_create_manual_flight.php',{user:qs('user').value,date:qs('date').value,mode:'pair',glider_callsign:qs('glider').value,pilot_name:qs('pilot').value,attendant_name:qs('att').value,tow_callsign:qs('plane').value,tow_pilot_name:qs('towpilot').value,takeoff_time:qs('takeoff').value,tow_landing_time:qs('towlanding').value,glider_landing_time:qs('gliderlanding').value,vf_flight_type_id:qs('ft').value,charge_mode:qs('charge').value})}function submitAttachTow(){if(!validateFields([{id:'opid',label:'Bestehender Segelflug fehlt'},{id:'plane',label:'Motorflugzeug fehlt'},{id:'takeoff',label:'Startzeit fehlt'},{id:'towlanding',label:'Landung Motorflugzeug fehlt'}]))return;return postJson('../src/api_create_manual_flight.php',{user:qs('user').value,date:qs('date').value,mode:'attach_tow_to_glider',operation_id:qs('opid').value,tow_callsign:qs('plane').value,tow_pilot_name:qs('towpilot').value,takeoff_time:qs('takeoff').value,tow_landing_time:qs('towlanding').value,departure_location:'LSZJ'})}function submitAttachGlider(){if(!validateFields([{id:'opid',label:'Bestehender Motorflug fehlt'},{id:'glider',label:'Segelflugzeug fehlt'},{id:'takeoff',label:'Startzeit fehlt'},{id:'towlanding',label:'Landung Motorflugzeug fehlt'},{id:'gliderlanding',label:'Landung Segelflugzeug fehlt'},{id:'ft',label:'Flugart Segelflug fehlt'},{id:'charge',label:'Abrechnungsart Segelflug fehlt'}]))return;return postJson('../src/api_create_manual_flight.php',{user:qs('user').value,date:qs('date').value,mode:'attach_glider_to_towplane',operation_id:qs('opid').value,glider_callsign:qs('glider').value,pilot_name:qs('pilot').value,attendant_name:qs('att').value,takeoff_time:qs('takeoff').value,tow_landing_time:qs('towlanding').value,glider_landing_time:qs('gliderlanding').value,vf_flight_type_id:qs('ft').value,charge_mode:qs('charge').value})}showMode(getParam('mode','glider'))
</script><script src="i18n.js"></script>
</body></html>
